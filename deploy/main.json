{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "5224429521808818018"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region of the app; the managed environment's by default."
      }
    },
    "environmentId": {
      "type": "string",
      "metadata": {
        "description": "The existing Container Apps managed environment, by resource id."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "ca-lex-v3",
      "metadata": {
        "description": "The container app's name."
      }
    },
    "image": {
      "type": "string",
      "metadata": {
        "description": "The release image by digest, <registry>/<repository>@sha256:<64 lower-case hex>. deploy.ps1 refuses a tag."
      }
    },
    "registryServer": {
      "type": "string",
      "metadata": {
        "description": "The registry server the image is pulled from with the managed identity."
      }
    },
    "identityResourceId": {
      "type": "string",
      "metadata": {
        "description": "The user-assigned managed identity the app pulls its image with, by resource id. No secret is stored."
      }
    },
    "revisionSuffix": {
      "type": "string",
      "metadata": {
        "description": "The revision suffix naming the release: lower-case letters, digits and hyphens."
      }
    },
    "liveRevision": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The revision serving traffic now, kept at 100 per cent; empty on the first deployment."
      }
    },
    "probeSourceCidr": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "On a first deployment only: the one address range ingress admits (the owner's probe), as a CIDR."
      }
    }
  },
  "variables": {
    "firstDeployment": "[empty(parameters('liveRevision'))]"
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('identityResourceId'))]": {}
        }
      },
      "properties": {
        "environmentId": "[parameters('environmentId')]",
        "configuration": {
          "activeRevisionsMode": "Multiple",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "http",
            "allowInsecure": false,
            "traffic": "[if(variables('firstDeployment'), createArray(createObject('latestRevision', true(), 'weight', 100, 'label', 'candidate')), createArray(createObject('revisionName', parameters('liveRevision'), 'weight', 100), createObject('latestRevision', true(), 'weight', 0, 'label', 'candidate')))]",
            "ipSecurityRestrictions": "[if(and(variables('firstDeployment'), not(empty(parameters('probeSourceCidr')))), createArray(createObject('name', 'owner-probe-only', 'description', 'First deployment: only the owner''s probe reaches the candidate until promotion.', 'ipAddressRange', parameters('probeSourceCidr'), 'action', 'Allow')), createArray())]"
          },
          "registries": [
            {
              "server": "[parameters('registryServer')]",
              "identity": "[parameters('identityResourceId')]"
            }
          ]
        },
        "template": {
          "revisionSuffix": "[parameters('revisionSuffix')]",
          "containers": [
            {
              "name": "lex-v3",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "ASPNETCORE_HTTP_PORTS",
                  "value": "8080"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/",
                    "port": 8080
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/evaluation-card.json",
                    "port": 8080
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "tmp",
                  "mountPath": "/tmp"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          },
          "volumes": [
            {
              "name": "tmp",
              "storageType": "EmptyDir"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "candidateRevision": {
      "type": "string",
      "metadata": {
        "description": "The revision this deployment created."
      },
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').latestRevisionName]"
    },
    "fqdn": {
      "type": "string",
      "metadata": {
        "description": "The app's host name; the candidate label's host is <app>---candidate.<environment domain>."
      },
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn]"
    }
  }
}