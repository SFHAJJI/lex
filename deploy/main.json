{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "12541439499334168413"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region of the app; the managed environment's by default."
      }
    },
    "environmentId": {
      "type": "string",
      "metadata": {
        "description": "The existing Container Apps managed environment, by resource id."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "ca-lex-v3",
      "metadata": {
        "description": "The container app's name."
      }
    },
    "image": {
      "type": "string",
      "metadata": {
        "description": "The release image by digest, <registry>/<repository>@sha256:<64 lower-case hex>. deploy.ps1 refuses a tag."
      }
    },
    "registryServer": {
      "type": "string",
      "metadata": {
        "description": "The registry server the image is pulled from with the managed identity."
      }
    },
    "identityResourceId": {
      "type": "string",
      "metadata": {
        "description": "The user-assigned managed identity the app pulls its image with, by resource id. No secret is stored."
      }
    },
    "revisionSuffix": {
      "type": "string",
      "metadata": {
        "description": "The revision suffix naming the release: lower-case letters, digits and hyphens."
      }
    },
    "liveRevision": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The revision serving traffic now, kept at 100 per cent; empty on the first deployment."
      }
    },
    "allowedSourceCidrs": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Until the opening: the address ranges ingress admits, as CIDRs. A deployment that names none admits no one."
      }
    },
    "openToPublic": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "True only once the owner has opened the site (deploy.ps1 -Public): ingress then admits everyone."
      }
    },
    "searchEngines": {
      "type": "string",
      "defaultValue": "kept-out",
      "allowedValues": [
        "kept-out",
        "indexed"
      ],
      "metadata": {
        "description": "Whether search engines may index the site, read by the API at startup as LEX_V3_SEARCH_ENGINES: kept-out (every page noindex, no sitemap) or indexed (the owner's answer to O27 on 2026-10-18; law pages still open only for the works the release's indexing record lists)."
      }
    },
    "customDomains": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "The custom domains bound to the app, as Azure holds them (name, bindingType, certificateId): deploy.ps1 reads them back and passes them on every deployment, so a redeployment keeps the binding. Empty until law.soufien.lu is bound (deploy/bind-domain.ps1)."
      }
    },
    "maintenance": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "True for the release's maintenance revision (deploy.ps1 -Maintenance; R60, R108, R115): the same image with LEX_V3_MAINTENANCE=on, serving only the maintenance page, deployed with no traffic beside the live revision, which keeps 100 per cent."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "allowedOnly",
        "count": "[length(parameters('allowedSourceCidrs'))]",
        "input": {
          "name": "[format('private-copy-{0}', add(copyIndex('allowedOnly'), 1))]",
          "description": "The private copy: only the named addresses reach it until the owner opens the site.",
          "ipAddressRange": "[parameters('allowedSourceCidrs')[copyIndex('allowedOnly')]]",
          "action": "Allow"
        }
      }
    ],
    "firstDeployment": "[empty(parameters('liveRevision'))]",
    "releaseProbes": [
      {
        "type": "Startup",
        "httpGet": {
          "path": "/",
          "port": 8080
        },
        "initialDelaySeconds": 10,
        "periodSeconds": 30,
        "failureThreshold": 40
      },
      {
        "type": "Liveness",
        "httpGet": {
          "path": "/",
          "port": 8080
        },
        "initialDelaySeconds": 10,
        "periodSeconds": 30
      },
      {
        "type": "Readiness",
        "httpGet": {
          "path": "/health/ready",
          "port": 8080
        },
        "initialDelaySeconds": 5,
        "periodSeconds": 10
      }
    ],
    "maintenanceProbes": [
      {
        "type": "Startup",
        "httpGet": {
          "path": "/health/ready",
          "port": 8080
        },
        "initialDelaySeconds": 2,
        "periodSeconds": 5,
        "failureThreshold": 10
      },
      {
        "type": "Liveness",
        "httpGet": {
          "path": "/health/ready",
          "port": 8080
        },
        "initialDelaySeconds": 2,
        "periodSeconds": 30
      },
      {
        "type": "Readiness",
        "httpGet": {
          "path": "/health/ready",
          "port": 8080
        },
        "initialDelaySeconds": 2,
        "periodSeconds": 10
      }
    ],
    "admitNoOne": [
      {
        "name": "private-copy-closed",
        "description": "No address range was named: the private copy admits no one.",
        "ipAddressRange": "192.0.2.1/32",
        "action": "Allow"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('identityResourceId'))]": {}
        }
      },
      "properties": {
        "environmentId": "[parameters('environmentId')]",
        "configuration": {
          "activeRevisionsMode": "Multiple",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "http",
            "allowInsecure": false,
            "traffic": "[if(parameters('maintenance'), createArray(createObject('revisionName', parameters('liveRevision'), 'weight', 100), createObject('latestRevision', true(), 'weight', 0, 'label', 'maintenance')), if(variables('firstDeployment'), createArray(createObject('latestRevision', true(), 'weight', 100, 'label', 'candidate')), createArray(createObject('revisionName', parameters('liveRevision'), 'weight', 100), createObject('latestRevision', true(), 'weight', 0, 'label', 'candidate'))))]",
            "ipSecurityRestrictions": "[if(parameters('openToPublic'), createArray(), if(empty(parameters('allowedSourceCidrs')), variables('admitNoOne'), variables('allowedOnly')))]",
            "customDomains": "[parameters('customDomains')]"
          },
          "registries": [
            {
              "server": "[parameters('registryServer')]",
              "identity": "[parameters('identityResourceId')]"
            }
          ]
        },
        "template": {
          "revisionSuffix": "[parameters('revisionSuffix')]",
          "containers": [
            {
              "name": "lex-v3",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('2.0')]",
                "memory": "4Gi"
              },
              "env": [
                {
                  "name": "ASPNETCORE_HTTP_PORTS",
                  "value": "8080"
                },
                {
                  "name": "LEX_V3_TEMP_IS_PRIVATE",
                  "value": "1"
                },
                {
                  "name": "LEX_V3_SEARCH_ENGINES",
                  "value": "[parameters('searchEngines')]"
                },
                {
                  "name": "LEX_V3_MAINTENANCE",
                  "value": "[if(parameters('maintenance'), 'on', 'off')]"
                }
              ],
              "probes": "[if(parameters('maintenance'), variables('maintenanceProbes'), variables('releaseProbes'))]",
              "volumeMounts": [
                {
                  "volumeName": "tmp",
                  "mountPath": "/tmp"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          },
          "volumes": [
            {
              "name": "tmp",
              "storageType": "EmptyDir"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "candidateRevision": {
      "type": "string",
      "metadata": {
        "description": "The revision this deployment created."
      },
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').latestRevisionName]"
    },
    "fqdn": {
      "type": "string",
      "metadata": {
        "description": "The app's host name; the candidate label's host is <app>---candidate.<environment domain>."
      },
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn]"
    }
  }
}