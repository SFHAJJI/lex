              }
            },
            "required": [
              "status",
              "host",
              "resource_path",
              "accept_media_type",
              "accept_language",
              "not_minted_reason"
            ],
            "additionalProperties": false
          },
          "row_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "object_ordinal",
          "selectors",
          "rule_match_bits_base64_url",
          "matched_evaluations",
          "axis_winning_rule_ordinals",
          "fetch_address",
          "row_sha256"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
