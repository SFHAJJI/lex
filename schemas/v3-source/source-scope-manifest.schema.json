              },
              "ordinal": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "axis",
              "rule_member_ordinal",
              "ordinal"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "body_candidate_role_member_ordinal": {
          "type": "integer",
          "minimum": 0
        }
