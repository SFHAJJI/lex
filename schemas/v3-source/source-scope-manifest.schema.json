        "ordered_selector_member_ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ordered_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
