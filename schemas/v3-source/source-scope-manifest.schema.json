    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "selectors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "enum": [
                    "publisher_value_present",
                    "publisher_value_absent",
                    "publisher_value_conflict",
                    "selector_not_applicable"
                  ]
                },
                "canonical_values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "$comment": "Length is limited to 4096 Unicode scalar values. The verified reader rejects invalid Unicode scalar sequences."
                  },
                  "uniqueItems": true
                },
                "evidence_kind": {
                  "enum": [
                    "observed_value_set",
                    "complete_observation_absence",
                    "observed_conflicting_value_set",
                    null
                  ]
                },
                "evidence_artifact_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "rule_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "cause_member_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "state",
                "canonical_values",
                "evidence_kind",
                "evidence_artifact_ordinal",
                "rule_ordinal",
                "cause_member_ordinal"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "properties": {
                    "state": {
                      "const": "publisher_value_present"
                    },
                    "canonical_values": {
                      "minItems": 1
                    },
                    "evidence_kind": {
                      "const": "observed_value_set"
                    },
                    "evidence_artifact_ordinal": {
                      "not": {
                        "type": "null"
                      }
                    },
                    "rule_ordinal": {
                      "type": "null"
                    },
                    "cause_member_ordinal": {
                      "type": "null"
                    }
                  }
                },
                {
                  "properties": {
                    "state": {
                      "const": "publisher_value_absent"
                    },
                    "canonical_values": {
                      "maxItems": 0
                    },
                    "evidence_kind": {
                      "const": "complete_observation_absence"
                    },
                    "evidence_artifact_ordinal": {
                      "not": {
                        "type": "null"
                      }
                    },
                    "rule_ordinal": {
                      "type": "null"
                    },
                    "cause_member_ordinal": {
                      "type": "null"
                    }
                  }
                },
                {
                  "properties": {
                    "state": {
                      "const": "publisher_value_conflict"
                    },
                    "canonical_values": {
                      "minItems": 2
                    },
                    "evidence_kind": {
                      "const": "observed_conflicting_value_set"
                    },
                    "evidence_artifact_ordinal": {
                      "not": {
                        "type": "null"
                      }
                    },
                    "rule_ordinal": {
                      "type": "null"
                    },
                    "cause_member_ordinal": {
                      "not": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "state": {
                      "const": "selector_not_applicable"
                    },
                    "canonical_values": {
                      "maxItems": 0
                    },
                    "evidence_kind": {
                      "type": "null"
                    },
                    "evidence_artifact_ordinal": {
                      "type": "null"
                    },
                    "rule_ordinal": {
                      "not": {
                        "type": "null"
                      }
                    },
                    "cause_member_ordinal": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          },
          "rule_match_bits_base64_url": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]\u002B(?![\\s\\S])",
            "minLength": 1
          },
          "matched_evaluations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_ordinal": {
                  "type": "integer",
                  "minimum": 0
                },
                "effect": {
                  "enum": [
                    "positive",
                    "exact_denial"
                  ]
                },
                "disposition": {
                  "enum": [
                    "accepted_selected",
                    "typed_quarantine",
                    "point",
                    "never_ingest"
                  ]
                },
                "role_member_ordinals": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uniqueItems": true
                },
                "capability_member_ordinals": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "rule_ordinal",
                "effect",
                "disposition",
                "role_member_ordinals",
                "capability_member_ordinals"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "effect": {
                        "const": "exact_denial"
                      }
                    },
                    "required": [
                      "effect"
                    ]
                  },
                  "then": {
                    "properties": {
                      "disposition": {
                        "not": {
                          "const": "accepted_selected"
                        }
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "not": {
                          "const": "accepted_selected"
                        }
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "role_member_ordinals": {
                        "maxItems": 0
                      },
                      "capability_member_ordinals": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              ]
            },
            "uniqueItems": true
          },
          "axis_winning_rule_ordinals": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "$comment": "Fixed record axis position."
              },
              {
                "type": "integer",
                "minimum": 0,
                "$comment": "Fixed body axis position."
              },
              {
                "type": "integer",
                "minimum": 0,
                "$comment": "Fixed relation axis position."
              },
              {
                "type": "integer",
                "minimum": 0,
                "$comment": "Fixed supporting_document axis position."
              }
            ]
          },
          "fetch_address": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "minted",
                  "not_minted"
                ]
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resource_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "accept_media_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "accept_language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "not_minted_reason": {
                "enum": [
                  "no_publisher_route_yet",
                  null
