              "minLength": 45,
              "maxLength": 45
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "resource_id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "selector_table_ref": {
