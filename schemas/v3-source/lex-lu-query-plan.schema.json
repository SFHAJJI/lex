      "type": "integer",
      "const": 997
    },
    "pass_2_page_limit": {
      "type": "integer",
      "const": 613
    },
    "partition_rule": {
      "type": "object",
      "properties": {
        "accumulated_completed_slice_threshold": {
          "type": "integer",
          "const": 900
        },
        "cardinality_basis": {
          "type": "string",
          "const": "accumulated_completed_slice_cardinality"
        },
        "split_rule_identity": {
          "type": "string",
