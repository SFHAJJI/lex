        "terminal_child_maximum_rows": {
          "type": "integer",
          "const": 899
        },
        "empty_child_ranges_retained": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "accumulated_completed_slice_threshold",
        "cardinality_basis",
        "split_rule_identity",
        "terminal_child_maximum_rows",
        "empty_child_ranges_retained"
      ],
      "additionalProperties": false
    },
    "completion_rule": {
      "type": "object",
      "properties": {
        "successor_after_full_page_required": {
          "type": "boolean",
          "const": true
        },
        "empty_successor_after_short_page_required": {
          "type": "boolean",
          "const": true
        },
        "duplicate_key_rejects_observation": {
          "type": "boolean",
          "const": true
        },
        "non_strict_order_rejects_observation": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "successor_after_full_page_required",
        "empty_successor_after_short_page_required",
        "duplicate_key_rejects_observation",
        "non_strict_order_rejects_observation"
      ],
      "additionalProperties": false
