      "type": "object",
      "properties": {
        "comparison": {
          "type": "string",
          "const": "strict_greater_than"
        },
        "order_by": {
          "type": "string",
          "const": "canonical_utf8_tuple_ascending"
        },
        "component_count": {
          "type": "integer",
          "const": 6
        },
        "empty_successor_required": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "comparison",
        "order_by",
        "component_count",
        "empty_successor_required"
      ],
      "additionalProperties": false
    },
