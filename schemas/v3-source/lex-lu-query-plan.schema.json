{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "lex-lu-query-plan/1"
    },
    "dataset_graph_identity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "default_graph"
          ]
        },
        "endpoint": {
          "type": "string",
          "const": "https://data.legilux.public.lu/sparqlendpoint"
        },
        "source_profile_ref": {
          "type": "object",
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^urn:uuid:(?!00000000-0000-0000-0000-000000000000)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
              "minLength": 45,
              "maxLength": 45
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "resource_id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "scope_definition_ref": {
          "type": "object",
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^urn:uuid:(?!00000000-0000-0000-0000-000000000000)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
              "minLength": 45,
              "maxLength": 45
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "resource_id",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "endpoint",
        "source_profile_ref",
        "scope_definition_ref"
      ],
      "additionalProperties": false
    },
    "scheme_roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "selector_predicates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "relation_predicates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "set_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "set_id": {
            "type": "string"
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "acquisition": {
            "enum": [
              "publisher_query",
              "local_materialization"
            ]
          },
          "key_kind": {
            "enum": [
              "absolute_iri_utf8",
              "composite_literal_utf8"
            ]
          }
        },
        "required": [
          "set_id",
          "template_id",
          "acquisition",
          "key_kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "query_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "utf8_query_template": {
            "type": "string"
          },
          "utf8_count_template": {
            "type": "string"
          }
        },
        "required": [
          "template_id",
          "utf8_query_template",
          "utf8_count_template"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
