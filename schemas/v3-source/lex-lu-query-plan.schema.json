  "required": [
    "schema",
    "dataset_graph_identity",
    "scheme_roots",
    "selector_predicates",
    "relation_predicates",
    "set_definitions",
    "query_templates",
    "keyset_successor_rule",
    "pass_1_page_limit",
    "pass_2_page_limit",
    "partition_rule",
    "completion_rule"
  ],
  "additionalProperties": false,
  "$id": "urn:uuid:65ff531a-8db0-4723-b3d8-2fc9c8e91c10",
