{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "lex-v3-local-inbound-view/1"
    },
    "target": {
      "type": "object",
      "properties": {
        "publisher": {
          "enum": [
            "lu-legilux",
            "eu-eurlex"
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {
                "enum": [
                  "eli",
                  "celex",
                  "ecli",
                  "cellar_work_uri",
                  "cellar_resource_uri",
                  "memorial",
                  "historical_legal_id"
                ]
              },
              "raw_value": {
                "type": "string"
              }
            },
            "required": [
              "family",
              "raw_value"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "publisher",
        "identifiers"
      ],
      "additionalProperties": false
    },
    "predicate_uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "scope_is_complete": {
      "type": "boolean"
    },
    "scope_descriptor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contributing_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "lex-v3-publisher-relation/1"
          },
          "source": {
            "type": "object",
            "properties": {
              "publisher": {
                "enum": [
                  "lu-legilux",
                  "eu-eurlex"
                ]
              },
              "identifiers": {
                "$ref": "#/properties/target/properties/identifiers",
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "publisher",
              "identifiers"
            ],
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "properties": {
              "publisher": {
                "enum": [
                  "lu-legilux",
                  "eu-eurlex"
                ]
              },
              "identifiers": {
                "$ref": "#/properties/target/properties/identifiers",
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "publisher",
              "identifiers"
            ],
            "additionalProperties": false
          },
          "predicate_uri": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "observation": {
            "type": "object",
            "properties": {
              "observation_id": {
                "type": "string"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\\u002B00:00)$"
              },
              "transport_bytes": {
                "type": "object",
                "properties": {
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "content_sha256",
                  "byte_length"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "observation_id",
              "observed_at",
              "transport_bytes"
            ],
            "additionalProperties": false
          },
          "qualified_axioms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "remote_axiom_id": {
                  "type": "string"
                },
                "qualifiers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "predicate_uri": {
                        "type": "string",
                        "format": "uri",
                        "minLength": 1
                      },
                      "raw_value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "predicate_uri",
                      "raw_value"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "remote_axiom_id",
                "qualifiers"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema",
          "source",
          "target",
          "predicate_uri",
          "observation",
          "qualified_axioms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "target",
    "predicate_uri",
    "scope_is_complete",
    "scope_descriptor_sha256",
    "contributing_assertions"
  ],
  "additionalProperties": false,
  "$id": "urn:uuid:3d804f51-7c6e-4a4b-af92-4db15e907173",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
