{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "lex-v3-vocabulary-drift/1"
    },
    "vocabulary": {
      "enum": [
        "relation_assertion_kind",
        "identifier_family",
        "ecli_state",
        "target_body_scope",
        "date_semantic_role",
        "date_precision",
        "date_open_sentinel"
      ]
    },
    "observed_term": {
      "type": "string"
    },
    "admitted_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "observation": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "transport_bytes": {
          "type": "object",
          "properties": {
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "content_sha256",
            "byte_length"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "observation_id",
        "observed_at",
        "transport_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "vocabulary",
    "observed_term",
    "admitted_terms",
    "observation"
  ],
  "additionalProperties": false,
  "$id": "urn:uuid:71c48395-b0a2-4e8f-e3d6-81f592d4b5b7",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
