        "raw_lexical_value": {
          "type": "string"
        },
        "datatype_uri": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "year",
            "year_month",
            "year_month_day"
          ]
        },
        "open_sentinel": {
          "enum": [
            "not_open",
            "open_ended"
          ]
        }
      },
      "required": [
        "schema",
        "raw_lexical_value",
        "datatype_uri",
        "precision",
        "open_sentinel"
      ],
      "additionalProperties": false
    },
    "source_predicate_uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "axiom": {
      "type": "object",
      "properties": {
        "remote_axiom_id": {
          "type": "string"
