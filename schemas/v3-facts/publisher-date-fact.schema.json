              },
              "raw_value": {
                "type": "string"
              }
            },
            "required": [
              "family",
              "raw_value"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "publisher",
        "identifiers"
      ],
      "additionalProperties": false
    },
    "date": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
