        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {
                "enum": [
                  "eli",
                  "celex",
                  "ecli",
                  "cellar_work_uri",
                  "cellar_resource_uri",
                  "memorial",
                  "historical_legal_id"
