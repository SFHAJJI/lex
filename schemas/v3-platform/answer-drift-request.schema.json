{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-answer_drift-request/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "const": "answer_drift"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}:(0|[1-9][0-9]{0,17})$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": []
    }
  },
  "required": [
    "operation_id",
    "parameters"
  ]
}
