{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-as_of-request/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "const": "as_of"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "identifier",
        "date"
      ]
    }
  },
  "required": [
    "operation_id",
    "parameters"
  ]
}
