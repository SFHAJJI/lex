{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-anchor_not_in_version-payload/1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "requested_anchor": {
      "type": "string"
    },
    "nearest_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "do_not_fall_back_to_full_text_search": {
      "const": true
    }
  },
