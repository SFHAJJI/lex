{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-search-request/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "const": "search"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "query",
        "language"
      ]
    }
  },
  "required": [
    "operation_id",
    "parameters"
  ]
}
