{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-cited_by-request/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "const": "cited_by"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "identifier"
      ]
    }
  },
  "required": [
    "operation_id",
    "parameters"
  ]
}
