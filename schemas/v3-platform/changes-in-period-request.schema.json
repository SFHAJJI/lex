{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-changes_in_period-request/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "const": "changes_in_period"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date_from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "date_to": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "date_from",
        "date_to"
      ]
    }
  },
  "required": [
    "operation_id",
    "parameters"
  ]
}
