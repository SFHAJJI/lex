                        "body_sha256": {
                          "const": null,
                          "minLength": 64,
                          "maxLength": 64,
                          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                        },
                        "body_holding_disposition": {
                          "const": "unknown_pending_evidence"
