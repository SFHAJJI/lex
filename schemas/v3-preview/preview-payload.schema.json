                  "held-public body is a valid Unicode scalar sequence with visible non-whitespace content",
                  "held-public body is at most the runtime UTF-8 byte bound"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "body_holding_state": {
                          "const": "held_public"
                        }
                      },
                      "required": [
                        "body_holding_state"
                      ]
                    },
                    "then": {
                      "properties": {
                        "body": {
                          "type": "string",
                          "minLength": 1
                        },
                        "body_sha256": {
                          "type": "string",
                          "minLength": 64,
                          "maxLength": 64,
                          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                        },
                        "body_holding_disposition": {
                          "const": "synthetic_fixture"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "body_holding_state": {
                          "const": "held_withheld"
                        }
                      },
                      "required": [
                        "body_holding_state"
                      ]
                    },
                    "then": {
                      "properties": {
                        "body": {
                          "const": null
