                        "body_sha256": {
                          "type": "string",
                          "minLength": 64,
                          "maxLength": 64,
                          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                        },
                        "body_holding_disposition": {
                          "const": "synthetic_fixture_withheld"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "body_holding_state": {
                          "const": "not_held"
                        }
                      },
                      "required": [
                        "body_holding_state"
                      ]
