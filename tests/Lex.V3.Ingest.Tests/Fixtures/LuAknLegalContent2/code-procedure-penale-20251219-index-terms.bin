				<title id="livre_ii.titre_ii-2" scl:hidden="false">
					<num>TITRE II-2.</num>
					<heading>
Des procédures menées à l’encontre des personnes morales
<docNumber>(L. 3 mars 2010)</docNumber>
					</heading>
					<article id="art_283" scl:uri="/eli/etat/leg/code/procedure_penale/art_283">
						<scl:JOLUXWork>
							<scl:JOLUXComplexWork>
								<scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/code/instruction_criminelle/art_283</scl:jolux>
							</scl:JOLUXComplexWork>
							<scl:JOLUXLegalResource>
								<scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/code/instruction_criminelle/art_283/20170905</scl:jolux>
								<scl:jolux scl:name="isMemberOf">http://data.legilux.public.lu/eli/etat/leg/loi/1808/11/17/n1</scl:jolux>
								<scl:jolux scl:lg="fra" scl:name="title">Art. 283.</scl:jolux>
								<scl:jolux scl:name="dateApplicability">2017-09-05</scl:jolux>
								<scl:rdf scl:name="type">http://data.legilux.public.lu/resource/ontology/jolux#Article</scl:rdf>
							</scl:JOLUXLegalResource>
						</scl:JOLUXWork>
						<num>Art. 283.</num>
						<alinea>
							<content>
								<p>
Abrogé (
<ref href="/eli/etat/leg/loi/1987/06/17/n2/jo">L. 17 juin 1987</ref>
)
</p>
							</content>
						</alinea>
					</article>
				</title>
			</book>
