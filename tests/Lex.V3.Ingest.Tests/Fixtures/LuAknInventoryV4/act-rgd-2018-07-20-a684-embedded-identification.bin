1/n2/jo</scl:jolux><scl:jolux scl:name="dateApplicability">2018-08-20</scl:jolux><scl:jolux scl:name="dateEntryInForce">2018-08-20</scl:jolux><scl:jolux scl:name="isPartOf">http://data.legilux.public.lu/eli/etat/leg/memorial/2018/a684</scl:jolux>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
