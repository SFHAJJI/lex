{"article_pk": 96064, "version_id": 3149, "art_id": "art_21", "number": "21", "num_raw": "Article 21", "heading": "Défaut de paiement de la prime", "path": "TITRE I LE CONTRAT D'ASSURANCE EN GENERAL > Chapitre II - Dispositions communes à tous les contrats > Section IV - Exécution du contrat", "article_since": "1997-09-07", "act_id": "/eli/etat/leg/loi/1997/07/27/n10", "act_title": "Loi du 27 juillet 1997 sur le contrat d'assurance.", "version_from": "2025-11-25", "version_to": null, "act_type": "LOI", "act_in_force": "1997-09-07", "act_date": "1997-07-27", "kind": "article", "repeal": null, "lines": [{"n": 1, "text": "A défaut de paiement d'une prime, ou d'une fraction de prime, dans les dix jours de son échéance et indépendamment du droit pour l'assureur de poursuivre l'exécution du contrat en justice, la garantie peut être suspendue à l'expiration d'un délai d'au moins trente jours suivant l'envoi au preneur d'assurance d'une lettre recommandée au dernier domicile connu.", "unit": "art_21/a1", "label": null}], "official": "https://legilux.public.lu/eli/etat/leg/loi/1997/07/27/n10/jo", "wording_since": "1997-09-07", "wording_until": null, "wording_no": 1, "wording_first_held": 1, "changed_by": [], "refers_to": [], "cited_by": [{"article_pk": 96067, "article": "Article 24", "heading": "Assurances sur la vie", "act_title": "Loi du 27 juillet 1997 sur le contrat d'assurance.", "type": "not_applicable", "trigger": "ne sont pas applicables", "certainty": "sure", "raw": "articles 21 à 23", "sub": null, "work": "loi-1997-07-27-n10", "anchor": "art_24", "date": "2025-11-25", "part": null}], "history": [{"version_from": "2006-12-25", "version_to": "2007-12-21", "article_pk": 212742, "text_sha": "53c8219e10344bbde63fd4b2ea584a43cb2389b24b856020a7874d3fe3106fd7", "changed": false}, {"version_from": "2007-12-21", "version_to": "2011-04-16", "article_pk": 24236, "text_sha": "53c8219e10344bbde63fd4b2ea584a43cb2389b24b856020a7874d3fe3106fd7", "changed": false}, {"version_from": 