{
  "schema": "lex-browser-budget/v1",
  "toolchain": {
    "playwright": "1.62.1",
    "axe_core_playwright": "4.12.1",
    "lighthouse": "12.6.1",
    "browser": "chromium"
  },
  "viewports": {
    "desktop": [1280, 1100],
    "modal": [1099],
    "wcag_reflow_equivalent": [640, 320],
    "smallest": "320x568",
    "mobile_landscape": "568x320"
  },
  "lighthouse_mobile": {
    "routes": ["/", "/browse", "/built"],
    "lcp_ms_max": 2500,
    "cls_max": 0.1,
    "tbt_ms_max": 200
  },
  "accessibility": {
    "serious_violations_max": 0,
    "critical_violations_max": 0
  },
  "rendering": {
    "horizontal_overflow_px_max": 1,
    "launcher_intersections_max": 0
  }
}
