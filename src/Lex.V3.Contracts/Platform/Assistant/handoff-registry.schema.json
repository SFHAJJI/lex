{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lex-v3-handoff-registry/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "note", "entries"],
  "properties": {
    "schema": { "const": "lex-v3-handoff-registry/1" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "theme", "name", "link", "role", "introduced_as", "cost", "limits", "languages", "not_recorded", "link_checked_on", "review", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "theme": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "link": { "type": "string", "pattern": "^https://[a-z0-9.-]+/" },
          "role": { "enum": ["official_source", "information", "advice", "complaint", "mediation"] },
          "introduced_as": { "enum": ["official source", "information", "who can advise you", "where to complain", "mediation"] },
          "cost": { "type": ["string", "null"] },
          "limits": { "type": ["string", "null"] },
          "languages": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^[a-z]{2}$" } },
          "not_recorded": { "type": ["string", "null"] },
          "link_checked_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "review": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
