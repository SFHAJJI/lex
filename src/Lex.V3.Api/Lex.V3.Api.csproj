<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Lex.V3.Api</RootNamespace>
    <AssemblyName>Lex.V3.Api</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:0839314d08bb65da369135389a5d8291f75ace587fbb0488f469eb92c62eef68</ContainerBaseImage>
    <ContainerGenerateLabelsImageCreated>false</ContainerGenerateLabelsImageCreated>
    <ContainerImageFormat>OCI</ContainerImageFormat>
    <ContainerRepository>lex-v3-s0-05</ContainerRepository>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lex.V3.Artifacts/Lex.V3.Artifacts.csproj" />
    <ProjectReference Include="../Lex.V3.Contracts/Lex.V3.Contracts.csproj" />
    <ProjectReference Include="../Lex.V3.Ingest/Lex.V3.Ingest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/v3-platform/*.schema.json">
      <LogicalName>Lex.V3.Api.PlatformSchemas.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Remove="preview-graph/**/*" />
    <None Remove="preview-trust/**/*" />
    <Content Remove="preview-graph/**/*" />
    <Content Remove="preview-trust/**/*" />
  </ItemGroup>
  <!-- The synthetic preview and its key, for tests and the S0-05 image only: the one-server image, the build that names a
       corpus mount (web/scripts/image-rehearsal.mjs), publishes neither (plan 0.7), so its server starts no preview
       (Program.cs). The build output keeps both, and the tests run them. -->
  <PropertyGroup>
    <LexPreviewPublish Condition="'$(LexImageMount)' == ''">PreserveNewest</LexPreviewPublish>
    <LexPreviewPublish Condition="'$(LexImageMount)' != ''">Never</LexPreviewPublish>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="preview-graph/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="$(LexPreviewPublish)" />
    <Content Include="preview-trust/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="$(LexPreviewPublish)" />
  </ItemGroup>
  <!-- The one-server image (web/scripts/image-rehearsal.mjs): the built live pages and a corpus mount,
       published beside the API where it reads them (v3-web, v3-corpus), only when a build names them. -->
  <ItemGroup Condition="'$(LexImageWebRoot)' != ''">
    <Content Include="$(LexImageWebRoot)/**/*" Link="v3-web/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(LexImageMount)' != ''">
    <Content Include="$(LexImageMount)/**/*" Link="v3-corpus/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
