<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Lex.Index\Lex.Index.csproj" />
    <ProjectReference Include="..\Lex.Temporal\Lex.Temporal.csproj" />
    <ProjectReference Include="..\Lex.Mcp\Lex.Mcp.csproj" />
    <ProjectReference Include="..\Lex.Ask\Lex.Ask.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\architecture\pages\*.md">
      <Link>architecture\pages\%(Filename)%(Extension)</Link>
      <LogicalName>Lex.Web.architecture.pages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\architecture\diagrams\*.svg">
      <Link>architecture\diagrams\%(Filename)%(Extension)</Link>
      <LogicalName>Lex.Web.architecture.diagrams.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\architecture-program.json"
                      Link="architecture-program.json"
                      LogicalName="Lex.Web.architecture-program.json" />
    <EmbeddedResource Include="..\..\deploy\trusted-artifact-roots.json"
                      Link="trusted-artifact-roots.json"
                      LogicalName="Lex.Web.trusted-artifact-roots.json" />
    <EmbeddedResource Include="..\..\deploy\trusted-evaluation-review-roots.json"
                      Link="trusted-evaluation-review-roots.json"
                      LogicalName="Lex.Web.trusted-evaluation-review-roots.json" />
    <EmbeddedResource Include="..\..\evals\retrieval-cases.json"
                      Link="retrieval-cases.json"
                      LogicalName="Lex.Web.retrieval-cases.json" />
    <EmbeddedResource Include="..\..\evals\retrieval-baseline-v2.json"
                      Link="retrieval-baseline-v2.json"
                      LogicalName="Lex.Web.retrieval-baseline-v2.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
